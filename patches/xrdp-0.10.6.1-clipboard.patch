--- a/sesman/chansrv/clipboard_png.h
+++ b/sesman/chansrv/clipboard_png.h
@@ -0,0 +1,36 @@
+#ifndef MEGAS_CLIPBOARD_PNG_H
+#define MEGAS_CLIPBOARD_PNG_H
+#include <png.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+static void megas_put32(unsigned char *p, uint32_t n)
+{ p[0]=n; p[1]=n>>8; p[2]=n>>16; p[3]=n>>24; }
+/* Decode bounded PNG to a top-down 24-bit BMP for legacy X clipboard clients. */
+static int megas_png_to_bmp(const void *data, size_t size,
+                            unsigned char **output, size_t *output_size)
+{
+    png_image image;
+    size_t stride, total;
+    unsigned char *bmp;
+    *output = NULL; *output_size = 0;
+    if (size < 8 || size > 64u*1024u*1024u) return 0;
+    memset(&image,0,sizeof(image)); image.version=PNG_IMAGE_VERSION;
+    if (!png_image_begin_read_from_memory(&image,data,size)) return 0;
+    if (!image.width || !image.height || image.width>16384 || image.height>16384)
+    { png_image_free(&image); return 0; }
+    stride=((size_t)image.width*3u+3u)&~(size_t)3u;
+    total=54u+stride*image.height;
+    if (total>64u*1024u*1024u) { png_image_free(&image); return 0; }
+    bmp=(unsigned char *)calloc(1,total);
+    if (!bmp) { png_image_free(&image); return 0; }
+    bmp[0]='B';bmp[1]='M';megas_put32(bmp+2,(uint32_t)total);
+    megas_put32(bmp+10,54);megas_put32(bmp+14,40);
+    megas_put32(bmp+18,image.width);megas_put32(bmp+22,(uint32_t)(-(int32_t)image.height));
+    bmp[26]=1;bmp[28]=24;megas_put32(bmp+34,(uint32_t)(stride*image.height));
+    image.format=PNG_FORMAT_BGR;
+    if (!png_image_finish_read(&image,NULL,bmp+54,(png_int_32)stride,NULL))
+    { png_image_free(&image);free(bmp);return 0; }
+    png_image_free(&image);*output=bmp;*output_size=total;return 1;
+}
+#endif
